# GUARDRAIL-X environment configuration (copy to .env and adjust)
# NEVER put real API keys in this file or in target configs.

# --- application --------------------------------------------------------
GX_ENVIRONMENT=development
# GX_DATABASE_URL=postgresql+psycopg2://guardrailx:pass@localhost:5432/guardrailx
# (unset -> local SQLite under GX_DATA_DIR)
GX_LOG_LEVEL=INFO
GX_CORS_ORIGINS=*

# --- initial admin (only used on first bootstrap) -----------------------
GX_ADMIN_EMAIL=admin@guardrailx.local
# If unset, a random password is generated and written to data/initial_admin_password.txt
GX_ADMIN_PASSWORD=

# --- orchestration limits ----------------------------------------------
GX_MAX_CONCURRENT_EXPERIMENTS=4
GX_MAX_CASES_PER_EXPERIMENT=100
GX_CASE_TIMEOUT_SECONDS=120
GX_CASE_REPLAYS=2
GX_RATE_LIMIT_PER_MINUTE=600

# --- adapters (real credentials live here, never in the database) -------
# Any OpenAI-compatible endpoint: OpenAI, vLLM, Ollama (/v1), Groq, OpenRouter...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Or point a target's api_key_env at a different env var name.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
