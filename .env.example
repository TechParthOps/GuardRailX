# GUARDRAIL-X environment configuration (copy to .env and adjust)
# NEVER put real API keys or passwords in this file or in target configs.

# --- application --------------------------------------------------------
# production | development (production enforces strict requirements below)
GX_ENVIRONMENT=development
# PostgreSQL:  postgresql+psycopg://guardrailx:CHANGE-ME@localhost:5432/guardrailx
# (unset -> local SQLite under GX_DATA_DIR)
GX_DATABASE_URL=
GX_LOG_LEVEL=INFO
# development default "*"; production MUST list explicit origins
GX_CORS_ORIGINS=*
# OpenAPI docs: enabled in development, disabled in production
# GX_ENABLE_DOCS=true

# --- first-run administrator setup (NO default admin exists) -------------
# One-time token guarding POST /api/v1/setup. Set it, run setup, then remove it.
GX_SETUP_TOKEN=
# Or use the CLI instead:  python -m app.setup
# Credential reset for an existing account: python -m app.setup --reset-password

# --- account policies ----------------------------------------------------
GX_ALLOW_SIGNUP=true
# Require email verification before sign-in (needs SMTP delivery below)
GX_REQUIRE_EMAIL_VERIFICATION=false
# Self-serve password reset. Keep true in production ONLY with SMTP
# configured (or set false to disable the workflow entirely).
GX_ALLOW_PASSWORD_RESET=true

# --- account-token delivery (development vs production) ------------------
# console = tokens printed to the server console: DEVELOPMENT AND TESTS ONLY.
# In production, any enabled token workflow REQUIRES smtp (fail-closed).
GX_EMAIL_MODE=console
GX_SMTP_HOST=
GX_SMTP_PORT=587
GX_SMTP_USE_TLS=true
GX_SMTP_USE_SSL=false
GX_SMTP_USERNAME=
GX_SMTP_PASSWORD=
GX_SMTP_FROM=guardrailx@localhost
GX_SMTP_TIMEOUT_SECONDS=15
GX_VERIFICATION_TOKEN_TTL_MINUTES=1440
GX_RESET_TOKEN_TTL_MINUTES=60

# --- content & seeding ---------------------------------------------------
# Demo project + synthetic experiment: NEVER enable in production.
GX_SEED_DEMO_DATA=false

# --- orchestration limits -----------------------------------------------
GX_MAX_CONCURRENT_EXPERIMENTS=4
GX_MAX_CASES_PER_EXPERIMENT=100
GX_CASE_TIMEOUT_SECONDS=120
GX_CASE_REPLAYS=2
GX_RATE_LIMIT_PER_MINUTE=600

# --- outbound provider security (SSRF protection) ------------------------
# Credential env vars a target may reference (comma-separated, admin-controlled)
GX_ALLOWED_KEY_ENVS=OPENAI_API_KEY,ANTHROPIC_API_KEY,GEMINI_API_KEY,NVIDIA_API_KEY
# Extra endpoint hosts researchers may target (comma-separated); trusted
# provider hosts for the credentials above are always allowed.
GX_ALLOWED_ENDPOINT_HOSTS=
# Explicit operator opt-in for loopback/private model servers (Ollama/vLLM)
GX_ALLOW_LOCAL_ENDPOINTS=false

# --- adapters (real credentials live here, never in the database) --------
# Any OpenAI-compatible endpoint: OpenAI, vLLM, Ollama (/v1), Groq, OpenRouter...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- production requirements (GX_ENVIRONMENT=production enforces) --------
# GX_SECRET_KEY=<run: python -c "import secrets; print(secrets.token_urlsafe(48))">
# GX_CORS_ORIGINS=https://your-dashboard.example.com   (explicit, no wildcard)
# GX_SEED_DEMO_DATA=false (mandatory)
# GX_EMAIL_MODE=smtp + GX_SMTP_HOST/GX_SMTP_FROM (mandatory: password reset
#   is enabled by default; set GX_ALLOW_PASSWORD_RESET=false to run without
#   SMTP — the reset workflow is then disabled)
